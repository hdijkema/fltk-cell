@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(FLTK 1.4 CONFIG)
include("${CMAKE_CURRENT_LIST_DIR}/fltk-cell-targets.cmake")
foreach(component IN LISTS fltk-cell_FIND_COMPONENTS)
    if(component STREQUAL "css")
        find_dependency(fltk-css CONFIG)
        if(NOT TARGET fltk-cell::css)
            add_library(fltk-cell::css INTERFACE IMPORTED)
            set_property(TARGET fltk-cell::css PROPERTY INTERFACE_LINK_LIBRARIES "fltk-cell::fltk-cell;fltk-css::fltk-css")
        endif()
        set(fltk-cell_css_FOUND TRUE)
    else()
        set(fltk-cell_${component}_FOUND FALSE)
    endif()
endforeach()
check_required_components(fltk-cell)
